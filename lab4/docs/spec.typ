  ("DMatrix::zeros(n, m)", [Динамическая матрица $n times m$ из нулей (размер известен только во время работы программы).]),
  ("m[(i, j)]", [Элемент строки $i$ и столбца $j$; индексация кортежем.]),
  ("m.row(i).sum()", [Сумма элементов $i$-й строки.]),
  ("m.transpose()", [Транспонированная матрица (новая).]),
  ("m.row_mut(i).fill(x)", [Записывает $x$ во все элементы $i$-й строки на месте.]),
